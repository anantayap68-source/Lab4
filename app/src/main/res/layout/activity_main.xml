<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CfE0EB"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- หัวข้อหน้าหลัก -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="แอปพลิเคชันจดโน้ต"
        android:textColor="#082567"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- ปุ่มเพิ่มโน้ต -->
    <Button
        android:id="@+id/btnAddNote"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#8BADD3"
        android:text="ไปที่หน้าเพิ่มโน้ต (Add Note)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="2dp"
        android:layout_marginBottom="20dp" />

    <!-- การ์ดสำหรับแสดงรายการโน้ต -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="รายการโน้ตทั้งหมด"
            android:textColor="#2E5894"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDisplayNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ยังไม่มีข้อมูลโน้ต กดปุ่มด้านบนเพื่อเพิ่มโน้ตใหม่..."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</LinearLayout>